# Shared Node.js toolchain pin for sandbox services, CI, and @types/node.
#
# @types/node follows DefinitelyTyped package publishing and can advance one
# patch beyond the latest available official Node.js runtime image.
SANDBOX_NODE_VERSION=26.0.0
SANDBOX_NODE_MAJOR=26
SANDBOX_NODE_IMAGE=node:26.0.0
SANDBOX_TYPES_NODE_VERSION=26.0.1
