# Shared Node.js toolchain pin for sandbox services, CI, and @types/node.
#
# @types/node follows DefinitelyTyped package publishing, which can trail the
# Node.js runtime releases: it must stay on the same major as
# SANDBOX_NODE_VERSION and must not be newer than the runtime's minor line.
SANDBOX_NODE_VERSION=26.13.1
SANDBOX_NODE_MAJOR=26
#
# SANDBOX_NODE_IMAGE is the Docker base for the nb-bond-api and nb-ui builds. It
# is pinned as node:<SANDBOX_NODE_VERSION>@sha256:<digest>, where the digest is
# the multi-arch index digest (not a per-platform manifest digest), so amd64 and
# arm64 hosts resolve the same pinned content. The tag stays for readability;
# Docker resolves by digest. To bump: change SANDBOX_NODE_VERSION, then read the
# new index digest with `docker buildx imagetools inspect node:<version>` (the
# top-level "Digest:" line) and update it here. The consistency checker rejects
# a tag that disagrees with SANDBOX_NODE_VERSION or a missing digest.
SANDBOX_NODE_IMAGE=node:26.13.1@sha256:e18c3ccdf7d71619990b0e85639f506e2028a95410999cab24cc373cbd10e0ac
SANDBOX_TYPES_NODE_VERSION=26.6.5
