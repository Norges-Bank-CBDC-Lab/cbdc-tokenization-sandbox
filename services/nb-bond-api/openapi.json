{
  "openapi": "3.1.0",
  "info": {
    "title": "NB Bond Auction Service",
    "version": "2.0.0",
    "description": "Public API for the CBDC tokenization sandbox bond service. Sandbox-scale demo backing the nb-ui reference frontend. See docs/plans/openapi-v2-plan.md for design notes.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "servers": [
    {
      "url": "http://bond-api.cbdc-sandbox.local",
      "description": "Local Kind sandbox"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Service health"
    },
    {
      "name": "bonds",
      "description": "Bond resources (root of the resource tree)"
    },
    {
      "name": "auctions",
      "description": "Auction resources (bid/allocation subtree of a bond)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "getHealth",
        "summary": "Service health",
        "security": [],
        "responses": {
          "200": {
            "description": "Health and binding information",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds": {
      "get": {
        "tags": [
          "bonds"
        ],
        "operationId": "listBonds",
        "summary": "List all bonds with full subtree (auctions, bids, allocations, holders)",
        "responses": {
          "200": {
            "description": "All bonds. Primary cache-priming call for the UI.",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bond"
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — If-None-Match matched current ETag; cached body still valid."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds/{isin}": {
      "get": {
        "tags": [
          "bonds"
        ],
        "operationId": "getBond",
        "summary": "Get a single bond with full subtree",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Isin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bond resource",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bond"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — If-None-Match matched current ETag; cached body still valid."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds/{isin}/coupon-payments": {
      "post": {
        "tags": [
          "bonds"
        ],
        "operationId": "payCoupon",
        "summary": "Pay coupon to bond holders",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Isin"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldersBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bond after submitting the coupon-payment tx",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bond"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds/{isin}/redemptions": {
      "post": {
        "tags": [
          "bonds"
        ],
        "operationId": "redeem",
        "summary": "Redeem bond tokens for holders",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Isin"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldersBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bond after submitting the redemption tx",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bond"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds/{isin}/history": {
      "get": {
        "tags": [
          "bonds"
        ],
        "operationId": "listBondHistory",
        "summary": "Paginated event history for a bond and its auctions",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Isin"
            }
          },
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Return events with block < this value"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event history",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryEvent"
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — If-None-Match matched current ETag; cached body still valid."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/bonds/{isin}/auctions": {
      "post": {
        "tags": [
          "auctions"
        ],
        "operationId": "createAuction",
        "summary": "Create an auction under a bond. Response is the updated parent Bond.",
        "parameters": [
          {
            "in": "path",
            "name": "isin",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Isin"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuctionBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bond with the new auction appended",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bond"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/auctions": {
      "get": {
        "tags": [
          "auctions"
        ],
        "operationId": "listAuctions",
        "summary": "List all auctions across bonds (flat view of the full tree)",
        "responses": {
          "200": {
            "description": "All auctions with bids and allocations",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Auction"
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — If-None-Match matched current ETag; cached body still valid."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/auctions/{auctionId}": {
      "get": {
        "tags": [
          "auctions"
        ],
        "operationId": "getAuction",
        "summary": "Get a single auction subtree",
        "parameters": [
          {
            "in": "path",
            "name": "auctionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AuctionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Auction resource",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — If-None-Match matched current ETag; cached body still valid."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "auctions"
        ],
        "operationId": "closeAuction",
        "summary": "Transition auction to a new status. Only \"closed\" accepted today.",
        "parameters": [
          {
            "in": "path",
            "name": "auctionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AuctionId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseAuctionBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated auction after the state transition",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "auctions"
        ],
        "operationId": "cancelAuction",
        "summary": "Cancel auction (soft-delete; stays on-chain with status=\"cancelled\")",
        "parameters": [
          {
            "in": "path",
            "name": "auctionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AuctionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled auction (status=\"cancelled\")",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/auctions/{auctionId}/finalisation": {
      "put": {
        "tags": [
          "auctions"
        ],
        "operationId": "finaliseAuction",
        "summary": "Approve or reject the computed allocation",
        "parameters": [
          {
            "in": "path",
            "name": "auctionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AuctionId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinaliseBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated auction after finalisation",
            "headers": {
              "ETag": {
                "description": "MD5 of the response body. Reuse via If-None-Match for cache revalidation.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HoldersBody": {
        "type": "object",
        "properties": {
          "holders": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Address"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional subset of holders to pay/redeem. null = all holders."
          }
        },
        "required": [
          "holders"
        ],
        "description": "Body for coupon-payment and redemption operations"
      },
      "Address": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]{40}$",
        "description": "Ethereum address",
        "examples": [
          "0x1234567890abcdef1234567890abcdef12345678"
        ]
      },
      "CreateAuctionBody": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/AuctionType"
          },
          "end": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Auction close timestamp (unix seconds)",
            "examples": [
              "1000000000000000000"
            ],
            "$ref": "#/components/schemas/BigIntString"
          },
          "size": {
            "description": "Offering or buyback size in 1000-NOK units",
            "$ref": "#/components/schemas/BigIntString"
          },
          "maturityDuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds from distribution to maturity (required for RATE auctions)"
          }
        },
        "required": [
          "type",
          "end",
          "size",
          "maturityDuration"
        ],
        "description": "Request body for creating an auction under a bond"
      },
      "AuctionType": {
        "type": "string",
        "enum": [
          "RATE",
          "PRICE",
          "BUYBACK"
        ],
        "description": "Auction pricing model"
      },
      "BigIntString": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Decimal string representation of a uint256",
        "examples": [
          "1000000000000000000"
        ]
      },
      "CloseAuctionBody": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "closed",
            "description": "Target status. Only \"closed\" is accepted today; enum extensible later."
          }
        },
        "required": [
          "status"
        ],
        "description": "PATCH body for the close transition"
      },
      "FinaliseBody": {
        "type": "object",
        "properties": {
          "allocationHash": {
            "$ref": "#/components/schemas/HexString"
          },
          "approve": {
            "type": "boolean",
            "description": "true → finalised; false → rejected (allocation discarded)"
          }
        },
        "required": [
          "allocationHash",
          "approve"
        ],
        "description": "PUT body for approving or rejecting a computed allocation"
      },
      "HexString": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]+$",
        "description": "Hex string",
        "examples": [
          "0xabc123"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference categorising the error",
            "examples": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "HTTP status code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-readable explanation"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path that produced the error"
          },
          "errors": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProblemFieldError"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Populated for 400 validation failures; null otherwise"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "errors"
        ],
        "additionalProperties": false,
        "description": "RFC 7807 error body. Returned for every 4xx/5xx response."
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "additionalProperties": false,
        "description": "Per-field validation error"
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "contracts": {
            "$ref": "#/components/schemas/HealthContracts"
          },
          "sealingPubKey": {
            "$ref": "#/components/schemas/HexString"
          }
        },
        "required": [
          "status",
          "contracts",
          "sealingPubKey"
        ],
        "additionalProperties": false,
        "description": "Service health and binding information"
      },
      "HealthContracts": {
        "type": "object",
        "properties": {
          "bondManager": {
            "$ref": "#/components/schemas/Address"
          },
          "bondAuction": {
            "$ref": "#/components/schemas/Address"
          },
          "bondToken": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "required": [
          "bondManager",
          "bondAuction",
          "bondToken"
        ],
        "additionalProperties": false,
        "description": "Contract addresses the service is bound to"
      },
      "Bond": {
        "type": "object",
        "properties": {
          "isin": {
            "$ref": "#/components/schemas/Isin"
          },
          "status": {
            "$ref": "#/components/schemas/BondStatus"
          },
          "totalSupply": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ]
          },
          "contracts": {
            "$ref": "#/components/schemas/BondContracts"
          },
          "maturity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BondMaturity"
              },
              {
                "type": "null"
              }
            ]
          },
          "coupon": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BondCoupon"
              },
              {
                "type": "null"
              }
            ]
          },
          "holders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HolderBalance"
            }
          },
          "auctions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Auction"
            }
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "isin",
          "status",
          "totalSupply",
          "contracts",
          "maturity",
          "coupon",
          "holders",
          "auctions",
          "md5"
        ],
        "additionalProperties": false,
        "description": "Bond resource. Carries the full subtree of auctions, bids, allocations, and holders. A single GET /v1/bonds populates the entire UI cache."
      },
      "Isin": {
        "type": "string",
        "minLength": 1,
        "description": "ISIN identifying a bond",
        "examples": [
          "NO0012345678"
        ]
      },
      "BondStatus": {
        "type": "string",
        "enum": [
          "minting",
          "maturing",
          "matured",
          "redeemed",
          "unknown"
        ],
        "description": "Bond lifecycle status"
      },
      "BondContracts": {
        "type": "object",
        "properties": {
          "token": {
            "description": "ERC20 bond token contract",
            "$ref": "#/components/schemas/Address"
          },
          "auction": {
            "description": "BondAuction contract",
            "$ref": "#/components/schemas/Address"
          },
          "manager": {
            "description": "BondManager contract",
            "$ref": "#/components/schemas/Address"
          }
        },
        "required": [
          "token",
          "auction",
          "manager"
        ],
        "additionalProperties": false,
        "description": "On-chain contract addresses for this bond"
      },
      "BondMaturity": {
        "type": "object",
        "properties": {
          "duration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Configured maturity duration in seconds"
          },
          "date": {
            "anyOf": [
              {
                "description": "Unix timestamp in seconds (decimal string).",
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maturity date as unix timestamp"
          },
          "remaining": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds until maturity; 0 once matured"
          }
        },
        "required": [
          "duration",
          "date",
          "remaining"
        ],
        "additionalProperties": false,
        "description": "Maturity configuration and remaining time"
      },
      "BondCoupon": {
        "type": "object",
        "properties": {
          "duration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds between coupon payments"
          },
          "yieldBps": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Bps"
              },
              {
                "type": "null"
              }
            ],
            "description": "Annualised coupon yield in bps"
          },
          "payments": {
            "$ref": "#/components/schemas/CouponPayments"
          }
        },
        "required": [
          "duration",
          "yieldBps",
          "payments"
        ],
        "additionalProperties": false,
        "description": "Coupon configuration and payment progress"
      },
      "Bps": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Basis points (1e4 precision). 425 = 4.25%, 9875 = 98.75%.",
        "examples": [
          "425",
          "9875",
          "10123"
        ]
      },
      "CouponPayments": {
        "type": "object",
        "properties": {
          "total": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ]
          },
          "made": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ]
          },
          "remaining": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "total",
          "made",
          "remaining"
        ],
        "additionalProperties": false,
        "description": "Coupon payment progress"
      },
      "HolderBalance": {
        "type": "object",
        "properties": {
          "holder": {
            "$ref": "#/components/schemas/Address"
          },
          "balance": {
            "$ref": "#/components/schemas/BigIntString"
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "holder",
          "balance",
          "md5"
        ],
        "additionalProperties": false,
        "description": "A single bond holder and their balance"
      },
      "Auction": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/AuctionId"
          },
          "isin": {
            "$ref": "#/components/schemas/Isin"
          },
          "type": {
            "$ref": "#/components/schemas/AuctionType"
          },
          "status": {
            "$ref": "#/components/schemas/AuctionStatus"
          },
          "end": {
            "anyOf": [
              {
                "description": "Unix timestamp in seconds (decimal string).",
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scheduled close timestamp"
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Offering or buyback size in 1000-NOK units"
          },
          "maturityDuration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BigIntString"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds from distribution until maturity (required for RATE auctions)"
          },
          "owner": {
            "$ref": "#/components/schemas/Address"
          },
          "sealingPubKey": {
            "description": "Public key used by bidders to encrypt sealed bids",
            "$ref": "#/components/schemas/HexString"
          },
          "contracts": {
            "$ref": "#/components/schemas/AuctionContracts"
          },
          "bids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bid"
            }
          },
          "allocation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Allocation"
              },
              {
                "type": "null"
              }
            ]
          },
          "txs": {
            "$ref": "#/components/schemas/AuctionTxs"
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "id",
          "isin",
          "type",
          "status",
          "end",
          "size",
          "maturityDuration",
          "owner",
          "sealingPubKey",
          "contracts",
          "bids",
          "allocation",
          "txs",
          "md5"
        ],
        "additionalProperties": false,
        "description": "Auction resource with bids and allocation subtree"
      },
      "AuctionId": {
        "type": "string",
        "pattern": "^0x[a-fA-F0-9]{64}$",
        "description": "Auction identifier (bytes32 hex)",
        "examples": [
          "0x1234abcd00000000000000000000000000000000000000000000000000000000"
        ]
      },
      "AuctionStatus": {
        "type": "string",
        "enum": [
          "open",
          "closed",
          "finalised",
          "rejected",
          "cancelled"
        ],
        "description": "Auction lifecycle status"
      },
      "AuctionContracts": {
        "type": "object",
        "properties": {
          "auction": {
            "$ref": "#/components/schemas/Address"
          },
          "token": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "required": [
          "auction",
          "token"
        ],
        "additionalProperties": false,
        "description": "On-chain contract addresses owning this auction"
      },
      "Bid": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SealedBid"
          },
          {
            "$ref": "#/components/schemas/UnsealedBid"
          }
        ],
        "description": "Bid; discriminated by `state` — sealed during open, unsealed after close",
        "type": "object",
        "discriminator": {
          "propertyName": "state",
          "mapping": {
            "sealed": "#/components/schemas/SealedBid",
            "unsealed": "#/components/schemas/UnsealedBid"
          }
        }
      },
      "SealedBid": {
        "type": "object",
        "properties": {
          "bidder": {
            "$ref": "#/components/schemas/Address"
          },
          "state": {
            "type": "string",
            "const": "sealed"
          },
          "ciphertext": {
            "$ref": "#/components/schemas/HexString"
          },
          "plaintextHash": {
            "$ref": "#/components/schemas/HexString"
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "bidder",
          "state",
          "ciphertext",
          "plaintextHash",
          "md5"
        ],
        "additionalProperties": false,
        "description": "Bid in sealed (encrypted) state during an open auction"
      },
      "UnsealedBid": {
        "type": "object",
        "properties": {
          "bidder": {
            "$ref": "#/components/schemas/Address"
          },
          "state": {
            "type": "string",
            "const": "unsealed"
          },
          "rate": {
            "$ref": "#/components/schemas/Bps"
          },
          "units": {
            "$ref": "#/components/schemas/BigIntString"
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "bidder",
          "state",
          "rate",
          "units",
          "md5"
        ],
        "additionalProperties": false,
        "description": "Bid in unsealed (revealed) state after auction close"
      },
      "Allocation": {
        "type": "object",
        "properties": {
          "clearingRate": {
            "$ref": "#/components/schemas/Bps"
          },
          "totalAllocated": {
            "$ref": "#/components/schemas/BigIntString"
          },
          "hash": {
            "description": "Hash committing to the allocation result; matches on-chain",
            "$ref": "#/components/schemas/HexString"
          },
          "auctionType": {
            "$ref": "#/components/schemas/AuctionType"
          },
          "computedAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Unix timestamp in milliseconds."
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllocationEntry"
            }
          },
          "md5": {
            "type": "string",
            "description": "MD5 of canonical (key-sorted) JSON of this DTO. Server-computed; clients compare as opaque strings for cache validation.",
            "examples": [
              "9e107d9d372bb6826bd81d3542a419d6"
            ]
          }
        },
        "required": [
          "clearingRate",
          "totalAllocated",
          "hash",
          "auctionType",
          "computedAt",
          "entries",
          "md5"
        ],
        "additionalProperties": false,
        "description": "Computed allocation result for a closed auction"
      },
      "AllocationEntry": {
        "type": "object",
        "properties": {
          "bidder": {
            "$ref": "#/components/schemas/Address"
          },
          "units": {
            "$ref": "#/components/schemas/BigIntString"
          },
          "rate": {
            "$ref": "#/components/schemas/Bps"
          }
        },
        "required": [
          "bidder",
          "units",
          "rate"
        ],
        "additionalProperties": false,
        "description": "A single bidder share of a completed allocation"
      },
      "AuctionTxs": {
        "type": "object",
        "properties": {
          "create": {
            "$ref": "#/components/schemas/TxRef"
          },
          "close": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TxRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "finalise": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TxRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "cancel": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TxRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "create",
          "close",
          "finalise",
          "cancel"
        ],
        "additionalProperties": false,
        "description": "Latest transaction per state-changing action on this auction"
      },
      "TxRef": {
        "type": "object",
        "properties": {
          "hash": {
            "$ref": "#/components/schemas/HexString"
          },
          "block": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Block number, or null if not yet mined / unknown."
          }
        },
        "required": [
          "hash",
          "block"
        ],
        "additionalProperties": false,
        "description": "Reference to an on-chain transaction"
      },
      "HistoryEvent": {
        "type": "object",
        "properties": {
          "isin": {
            "$ref": "#/components/schemas/Isin"
          },
          "auctionId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuctionId"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set for auction-scoped events; null for bond-level events"
          },
          "type": {
            "type": "string",
            "description": "Event name as emitted by the contracts (e.g. \"BidSubmitted\", \"CouponPaid\")"
          },
          "block": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "txHash": {
            "$ref": "#/components/schemas/HexString"
          },
          "payload": {
            "description": "Event-specific opaque payload; clients treat as untyped JSON"
          }
        },
        "required": [
          "isin",
          "auctionId",
          "type",
          "block",
          "txHash",
          "payload"
        ],
        "additionalProperties": false,
        "description": "Auction or bond event observed on-chain"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed; `errors[]` populated.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or token invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Conflict": {
        "description": "Operation conflicts with current resource state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Microsoft Entra ID access token. In deployments where NB_BOND_API_AUTH_MODE=none (local sandbox default), the header is accepted but not validated."
      }
    }
  }
}
