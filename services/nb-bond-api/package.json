{
  "name": "nb-bond-api",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@11.14.1",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "clean:db": "rm -rf data && mkdir -p data && touch data/ingestion.sqlite",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "regen:openapi": "tsx scripts/regen-openapi.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "3.1.0",
    "better-sqlite3": "12.11.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "jose": "6.2.3",
    "winston": "3.19.0",
    "zod": "4.4.3",
    "zod-openapi": "5.4.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.5",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "babel-jest": "30.4.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "prettier": "3.9.4",
    "ts-jest": "29.4.11",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
