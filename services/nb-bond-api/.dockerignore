# Build context hygiene — keep image build fast and reproducible.
node_modules/
dist/
build/
coverage/
data/

# Tests aren't needed to produce the runtime image.
tests/

# Local dev metadata that has no business in the image.
.git/
.gitignore
.dockerignore
.prettierrc
.prettierignore
eslint.config.mjs
babel.config.cjs
jest.config.cjs
tsconfig.test.json
README.md
AGENTS.md
DEVELOPMENT.md
openapi.json
scripts/
helm/

# Local-only env files
.env
.env.*
npm-debug.log
