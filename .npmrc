# eslint-plugin-react@7.37.5's peerDependencies cap at eslint ^9.7 even
# though the plugin works fine with eslint 10 at runtime. Dependabot ships
# its own PRs with --legacy-peer-deps; mirror that so a fresh `npm install`
# on a developer machine doesn't break with ERESOLVE. Remove this line once
# eslint-plugin-react publishes a release with eslint ^10 in its peer-dep
# range.
legacy-peer-deps=true
