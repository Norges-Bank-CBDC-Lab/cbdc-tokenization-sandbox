{
  "name": "cbdc-tokenization-sandbox",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local CBDC sandbox monorepo. Use npm workspaces to install once at the repo root for all Node packages.",
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "services/nb-bond-api",
    "services/nb-ui",
    "scripts/bid-encryption",
    "scripts/bid-submitter"
  ],
  "overrides": {
    "ws": "8.21.0",
    "undici": "7.29.0",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
