{
  "name": "cbdc-tokenization-sandbox",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local CBDC sandbox monorepo. Use npm workspaces to install once at the repo root for all Node packages.",
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "services/nb-bond-api",
    "services/nb-ui",
    "scripts/bid-encryption",
    "scripts/bid-submitter"
  ],
  "devDependencies": {
    "@babel/core": "8.1.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "undici": "8.12.3",
    "js-yaml": "4.3.2",
    "qs": "6.17.0",
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "eslint-plugin-react": {
      "minimatch": {
        ".": "3.1.5",
        "brace-expansion": "1.1.21"
      }
    }
  }
}
